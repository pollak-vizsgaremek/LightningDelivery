generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model etelek {
  ID       Int        @id @default(autoincrement())
  Nev      String     @db.VarChar(100)
  Ar       Int
  Kaloria  Int
  rendeles rendeles[]
}

model italok {
  ID       Int        @id @default(autoincrement())
  Nev      String     @db.VarChar(100)
  Ar       Int
  Kaloria  Int
  rendeles rendeles[]
}

model rendeles {
  ID       Int    @id @default(autoincrement())
  EtelekID Int
  ItalokID Int
  italok   italok @relation(fields: [ItalokID], references: [ID], onUpdate: Restrict, map: "rendeles_ibfk_2")
  etelek   etelek @relation(fields: [EtelekID], references: [ID], onUpdate: Restrict, map: "rendeles_ibfk_3")

  @@index([EtelekID], map: "EtelekID")
  @@index([ItalokID], map: "ItalokID")
}
