generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model etelek {
  ID       Int        @id @default(autoincrement())
  Nev      String     @db.VarChar(100)
  Ar       Int
  Kaloria  Int
  menuk    menuk[]
  rendeles rendeles[]
}

model italok {
  ID       Int        @id @default(autoincrement())
  Nev      String     @db.VarChar(100)
  Ar       Int
  Kaloria  Int
  menuk    menuk[]
  rendeles rendeles[]
}

model rendeles {
  ID             Int          @id @default(autoincrement())
  EtelekID       Int
  ItalokID       Int
  FelhasznalokID Int
  felhasznalok   felhasznalok @relation(fields: [FelhasznalokID], references: [ID], onUpdate: Restrict, map: "rendeles_ibfk_1")
  italok         italok       @relation(fields: [ItalokID], references: [ID], onUpdate: Restrict, map: "rendeles_ibfk_2")
  etelek         etelek       @relation(fields: [EtelekID], references: [ID], onUpdate: Restrict, map: "rendeles_ibfk_3")

  @@index([EtelekID], map: "EtelekID")
  @@index([ItalokID], map: "ItalokID")
  @@index([FelhasznalokID], map: "FelhasznalokID")
}

model ettermek {
  ID                   Int          @id @default(autoincrement())
  EtteremNev           String       @db.VarChar(100)
  EtteremTipusID       Int
  EtteremKep           Bytes        @db.MediumBlob
  AtlagosSzallitasiIdo Int
  VarosID              Int
  Longitude            Float        @db.Float
  Latitude             Float        @db.Float
  varosok              varosok      @relation(fields: [VarosID], references: [ID], onUpdate: Restrict, map: "ettermek_ibfk_1")
  etteremtipus         etteremtipus @relation(fields: [EtteremTipusID], references: [ID], onUpdate: Restrict, map: "ettermek_ibfk_2")
  menuk                menuk[]

  @@index([VarosID], map: "VarosID")
  @@index([EtteremTipusID], map: "EtteremTipusID")
}

model varosok {
  ID        Int        @id @default(autoincrement())
  VarosNev  String     @db.VarChar(100)
  Longitude Float      @db.Float
  Latitude  Float      @db.Float
  ettermek  ettermek[]
}

model felhasznalok {
  ID                 Int        @id @default(autoincrement())
  Email              String     @unique(map: "Email") @db.VarChar(100)
  Jelszo             String     @db.VarChar(100)
  Felhasznalonev     String     @unique(map: "Felhasznalonev") @db.VarChar(100)
  PasswordResetToken String?    @db.VarChar(50)
  rendeles           rendeles[]
}

model menuk {
  ID         Int      @id @default(autoincrement())
  EttermekID Int
  MenuNev    String   @db.VarChar(100)
  MenuAr     Int
  EtelekID   Int
  ItalokID   Int
  AkciosE    Boolean
  AkciosAr   Int
  etelek     etelek   @relation(fields: [EtelekID], references: [ID], onUpdate: Restrict, map: "menuk_ibfk_1")
  italok     italok   @relation(fields: [ItalokID], references: [ID], onUpdate: Restrict, map: "menuk_ibfk_2")
  ettermek   ettermek @relation(fields: [EttermekID], references: [ID], onUpdate: Restrict, map: "menuk_ibfk_3")

  @@index([EtelekID, ItalokID], map: "EtelekID")
  @@index([ItalokID], map: "ItalokID")
  @@index([EttermekID], map: "EtteremID")
  @@index([EttermekID], map: "EttermekID")
}

model etteremtipus {
  ID           Int        @id @default(autoincrement())
  EtteremTipus String     @db.VarChar(100)
  ettermek     ettermek[]
}
