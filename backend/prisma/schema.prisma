generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model etelek {
  ID            Int             @id @default(autoincrement())
  Nev           String          @db.VarChar(100)
  Ar            Int
  Kaloria       Int
  EtteremID     Int?
  ettermek      ettermek?       @relation(fields: [EtteremID], references: [ID], onDelete: Restrict, onUpdate: Restrict, map: "fk_etelek_etterem")
  kosar_tetelek kosar_tetelek[]
  menu_etelek   menu_etelek[]

  @@index([EtteremID], map: "etelek_ibfk_1")
}

model italok {
  ID            Int             @id @default(autoincrement())
  Nev           String          @db.VarChar(100)
  Ar            Int
  Kaloria       Int
  EtteremID     Int?
  ettermek      ettermek?       @relation(fields: [EtteremID], references: [ID], onDelete: Restrict, onUpdate: Restrict, map: "fk_italok_etterem")
  kosar_tetelek kosar_tetelek[]
  menu_italok   menu_italok[]

  @@index([EtteremID], map: "italok_ibfk_1")
}

model ettermek {
  ID                   Int            @id @default(autoincrement())
  EtteremNev           String         @db.VarChar(100)
  EtteremTipusID       Int
  EtteremLancID        Int?
  AtlagosSzallitasiIdo Int
  VarosID              Int
  Longitude            Float          @db.Float
  Latitude             Float          @db.Float
  etelek               etelek[]
  varosok              varosok        @relation(fields: [VarosID], references: [ID], onUpdate: Restrict, map: "ettermek_ibfk_1")
  etteremtipus         etteremtipus   @relation(fields: [EtteremTipusID], references: [ID], onUpdate: Restrict, map: "ettermek_ibfk_2")
  etteremlancok        etteremlancok? @relation(fields: [EtteremLancID], references: [ID], onDelete: Restrict, onUpdate: Restrict, map: "ettermek_ibfk_3")
  italok               italok[]
  menuk                menuk[]

  @@index([VarosID], map: "ettermek_ibfk_1")
  @@index([EtteremTipusID], map: "ettermek_ibfk_2")
  @@index([EtteremLancID], map: "EtteremLancID")
}

model varosok {
  ID        Int        @id @default(autoincrement())
  VarosNev  String     @db.VarChar(100)
  Longitude Float      @db.Float
  Latitude  Float      @db.Float
  ettermek  ettermek[]
}

model felhasznalok {
  ID                 Int     @id @default(autoincrement())
  Email              String  @unique(map: "Email") @db.VarChar(100)
  Jelszo             String  @db.VarChar(100)
  Felhasznalonev     String  @unique(map: "Felhasznalonev") @db.VarChar(100)
  Jogosultsag        String  @default("USER") @db.VarChar(20)
  PasswordResetToken String? @db.VarChar(255)
}

model menuk {
  ID            Int             @id @default(autoincrement())
  EttermekID    Int
  MenuNev       String          @db.VarChar(100)
  MenuAr        Int
  AkciosE       Boolean
  AkciosAr      Int
  kosar_tetelek kosar_tetelek[]
  menu_etelek   menu_etelek[]
  menu_italok   menu_italok[]
  ettermek      ettermek        @relation(fields: [EttermekID], references: [ID], onUpdate: Restrict, map: "menuk_ibfk_3")

  @@index([EttermekID], map: "menuk_ibfk_3")
}

model etteremtipus {
  ID           Int        @id @default(autoincrement())
  EtteremTipus String     @db.VarChar(100)
  ettermek     ettermek[]
}

model menu_etelek {
  MenuID Int
  EtelID Int
  etelek etelek @relation(fields: [EtelID], references: [ID], onDelete: Cascade, onUpdate: Restrict, map: "fk_junction_etel")
  menuk  menuk  @relation(fields: [MenuID], references: [ID], onDelete: Cascade, onUpdate: Restrict, map: "fk_junction_menu_e")

  @@id([MenuID, EtelID])
  @@index([EtelID], map: "fk_junction_etel")
}

model menu_italok {
  MenuID Int
  ItalID Int
  italok italok @relation(fields: [ItalID], references: [ID], onDelete: Cascade, onUpdate: Restrict, map: "fk_junction_ital")
  menuk  menuk  @relation(fields: [MenuID], references: [ID], onDelete: Cascade, onUpdate: Restrict, map: "fk_junction_menu_i")

  @@id([MenuID, ItalID])
  @@index([ItalID], map: "fk_junction_ital")
}

model kosar_tetelek {
  ID        Int     @id
  KosarID   Int
  EtelekID  Int
  ItalokID  Int
  MenuID    Int
  Mennyiseg Int
  kosarak   kosarak @relation(fields: [KosarID], references: [ID], onUpdate: Restrict, map: "kosar_tetelek_ibfk_1")
  italok    italok  @relation(fields: [ItalokID], references: [ID], onUpdate: Restrict, map: "kosar_tetelek_ibfk_2")
  etelek    etelek  @relation(fields: [EtelekID], references: [ID], onUpdate: Restrict, map: "kosar_tetelek_ibfk_3")
  menuk     menuk   @relation(fields: [MenuID], references: [ID], onUpdate: Restrict, map: "kosar_tetelek_ibfk_4")

  @@index([EtelekID, ItalokID, MenuID], map: "EtelekID")
  @@index([ItalokID], map: "ItalokID")
  @@index([KosarID], map: "KosarID")
  @@index([MenuID], map: "MenuID")
}

model kosarak {
  ID            Int             @id
  FelhasznaloID Int
  Elkeszult     DateTime        @db.Date
  Modositott    DateTime        @db.Date
  kosar_tetelek kosar_tetelek[]

  @@index([FelhasznaloID], map: "FelhasznaloID")
}

model etteremlancok {
  ID           Int            @id @default(autoincrement())
  EtteremLanc  String         @db.VarChar(100)
  ettermek     ettermek[]
  preset_kepek preset_kepek[]
}

model preset_kepek {
  ID            Int            @id @default(autoincrement())
  EtteremLancID Int?
  EtteremKep    Bytes          @db.Blob
  etteremlancok etteremlancok? @relation(fields: [EtteremLancID], references: [ID], onDelete: Restrict, onUpdate: Restrict, map: "preset_kepek_ibfk_1")

  @@index([EtteremLancID], map: "EtteremLancID")
}
